# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# Replace 192.168.1.50 with the lab PC's IP address (find it with: hostname -I).

# Address browsers use to reach the API (baked into the client at build time)
VITE_API_URL=http://192.168.1.50:5000/api

# Origins the API accepts requests from
CLIENT_ORIGIN=http://192.168.1.50:8080,http://localhost:8080

# Use a long random value: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Code that lets someone sign up as a manager
MANAGER_SIGNUP_CODE=residefix-manager
