# Port the API listens on
PORT=5000
NODE_ENV=development

# Local MongoDB connection string (Docker Compose overrides this with the "mongo" service)
MONGO_URI=mongodb://127.0.0.1:27017/residefix

# Secret used to sign JWTs - use a long random string in any shared environment
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Anyone who signs up with this code becomes a manager instead of a resident
MANAGER_SIGNUP_CODE=residefix-manager

# Comma-separated list of origins allowed by CORS (Vite dev server, Docker client, GitHub Pages)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8080,https://supasan17.github.io

# Rate limiting: max requests per 15-minute window (general API / auth endpoints)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
