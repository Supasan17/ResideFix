{
  "name": "residefix-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ResideFix web client - React + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
